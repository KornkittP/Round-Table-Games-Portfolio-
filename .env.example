# Copy to .env at the repo root (bun run dev and the db scripts read it). .env is git-ignored. Never commit real values.

# --- Supabase project (Project Settings -> API) ---
# Public. Safe in the browser; the database tables are locked down by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used by the API to verify sign-in tokens. Defaults to NEXT_PUBLIC_SUPABASE_URL if unset.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only for projects still on the legacy shared JWT secret. Leave empty if your project
# uses the newer signing keys (the API then reads the public keys from your project).
SUPABASE_JWT_SECRET=

# --- Database (Supabase: Project Settings -> Database -> Connection string) ---
# SECRET. Contains the database password. Server only.
# Pooled connection (Transaction pooler, port 6543) for the running API:
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct or Session pooler connection (port 5432), used by db:migrate. Optional;
# falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=

# --- API ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Comma-separated emails that become admins when they sign in.
ADMIN_EMAILS=you@example.com
