# Copy to apps/web/.env.local. Leave API URL empty for the standalone studio catalog.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000

# Optional email form. Use a sender verified with Resend.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Optional header set and overwritten by your trusted reverse proxy.
CONTACT_CLIENT_IP_HEADER=

